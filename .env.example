# DATABASE_URL is intentionally omitted from this tracked template.
# Supply DATABASE_URL only through the untracked local .env file or a managed secret service.
# Never commit, print, or document the DATABASE_URL value.
ORPHANPROOF_ENV=development
ORPHANPROOF_CORS_ORIGINS=http://localhost:5173
ORPHANPROOF_LOG_LEVEL=INFO
ORPHANPROOF_AWS_REGION=us-east-1
ORPHANPROOF_BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
ORPHANPROOF_BEDROCK_REASONING_MODEL=amazon.nova-lite-v1:0
ORPHANPROOF_MCP_ENABLED=false
ORPHANPROOF_MCP_URL=https://cockroachlabs.cloud/mcp

# ORPHANPROOF_MCP_CLUSTER_ID and ORPHANPROOF_MCP_BEARER_TOKEN are intentionally omitted.
# Supply them only through the untracked local .env file or a managed secret service.
# Never commit, print, or document MCP cluster identifiers or bearer tokens.
